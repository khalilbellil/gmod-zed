{
    "for-i": {
        "prefix": "for-i",
        "body": [
            "for ${1:var} = ${2:index}, ${3:count} do",
            "\t$0",
            "end"
        ],
        "description": "Numeric for loop"
    },
    "for-pairs": {
        "prefix": "for-pairs",
        "body": [
